# ResQOne Backend - Production Environment Configuration
# Set these in Render Dashboard > Environment Variables

PORT=5001
NODE_ENV=production

# Frontend Application URL deployed on Vercel (Needed for CORS & Cookies)
# Example: https://resqone.vercel.app (No trailing slash)
CLIENT_URL=https://your-resqone-frontend.vercel.app

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/resqone?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/resqone?retryWrites=true&w=majority

# Strong Random JWT Secret for Production Authentication
JWT_SECRET=replace_with_a_long_random_secure_hex_or_string_for_production
JWT_EXPIRES_IN=7d

# Python AI Advisory Microservice URL (if deployed on Render, otherwise leave optional)
AI_SERVICE_URL=http://localhost:8000

# Production SMTP Email Credentials (Optional for real email delivery, defaults to Ethereal if omitted)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# SMTP_FROM=security@resqone.org
