# ResQOne Frontend - Production Environment Configuration
# Set these in Vercel Project Settings > Environment Variables

# Backend API URL (Your Render Backend URL with /api/v1)
VITE_API_BASE_URL=https://resqone-backend.onrender.com/api/v1

# Backend Socket.IO URL (Your Render Backend URL without trailing slash)
VITE_SOCKET_URL=https://resqone-backend.onrender.com
